{
  "manifest_version": 3,
  "name": "VAPT Lens",
  "version": "0.1.1",
  "description": "Guided, read-only VAPT assistant. Guidance only — no attacks performed. Test only systems you own or are authorized to test.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "VAPT Lens — guided testing only",
    "default_icon": {
      "16": "icons/icon-neon.svg",
      "32": "icons/icon-neon.svg",
      "48": "icons/icon-neon.svg",
      "128": "icons/icon-neon.svg"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "cookies",
    "webRequest",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css", "icons/*", "src/core/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon-neon.svg",
    "32": "icons/icon-neon.svg",
    "48": "icons/icon-neon.svg",
    "128": "icons/icon-neon.svg"
  }
}
